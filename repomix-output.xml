                  animationDelay: '2s',
                }}
              />
              <div
                className="absolute bottom-28 -left-6"
                style={{
                  width: '24px',
                  height: '24px',
                  borderRadius: '50%',
                  background: `linear-gradient(135deg, ${p.coralSoft}70 0%, ${p.roseBlush}50 100%)`,
                  boxShadow: `0 6px 20px ${p.coral}30`,
                  animation: 'heroFloatGentle 8s ease-in-out infinite',
                  animationDelay: '4s',
