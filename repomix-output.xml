const DashboardPage = () => {
  const [hasError, setHasError]           = useState(false)
  const [searchQuery, setSearchQuery]     = useState('')
  const [dayThreshold, setDayThreshold]   = useState(15)

  const { agregarToast, ToastContainer } = useAdminNotifications()

  const onStatsError = useCallback(() => {
    setHasError(true)
    agregarToast('No se pudieron cargar las estadísticas', 'error')
  }, [agregarToast])

  const { stats, isLoading, reload: reloadStats } = useDashboardStats(onStatsError)

  const {
    stagnantProducts,
    discountMap,
    applyingId,
    recentAdjustments,
    updateDiscount,
    applyDiscount,
    readjustProduct,
    confirmAdjustment,
  } = useStagnantProducts(dayThreshold)

  const handleDayThresholdChange = useCallback((e) => {
    setDayThreshold(Number(e.target.value))
  }, [])

  const handleApplyDiscount = useCallback(async (product, discountValue) => {
    const numericDiscount = clampDiscount(discountValue)

    if (numericDiscount === (product.discount_percent ?? 0)) {
      agregarToast('Este producto ya tiene ese descuento', 'info')
      return
    }

    const result = await applyDiscount(product, numericDiscount)

    if (result.success) {
      const previousPrice = product.price_original * (1 - (product.discount_percent ?? 0) / 100)
      const newPrice      = product.price_original * (1 - numericDiscount / 100)
      const saving        = formatCurrency(previousPrice - newPrice)
      agregarToast(
        `${product.name}: ${product.discount_percent ?? 0}% → ${numericDiscount}% (${saving})`,
        'success'
      )
    } else {
      agregarToast('No se pudo aplicar el descuento', 'error')
    }
  }, [applyDiscount, agregarToast])

  const handleExportCSV = useCallback(() => {
    exportStatsToCSV(stats)
    agregarToast('Estadísticas exportadas', 'success')
  }, [stats, agregarToast])

  const filteredStagnantProducts = useMemo(() =>
    stagnantProducts.filter((p) => {
      const term = searchQuery.toLowerCase()
      return (
        p.name?.toLowerCase().includes(term) ||
        p.sku?.toLowerCase().includes(term)
      )
    }),
    [stagnantProducts, searchQuery]
  )

  const statCards = useMemo(() => [
    {
      title:  'Total productos',
      value:  stats.totalProducts,
      linkTo: '/admin/productos',
      accent: false,
    },
    {
      title:  'Pedidos totales',
      value:  stats.totalOrders,
      linkTo: '/admin/pedidos',
      accent: false,
    },
    {
      title:  'Pedidos pendientes',
      value:  stats.pendingOrders,
      linkTo: '/admin/pedidos',
      accent: stats.pendingOrders > 0,
    },
    {
      title:  'Productos agotados',
      value:  stats.outOfStockProducts,
      linkTo: '/admin/productos',
      accent: stats.outOfStockProducts > 0,
    },
    {
      title:  'Ingresos semana',
      value:  formatCurrency(stats.weekRevenue),
      linkTo: '/admin/pedidos',
      accent: false,
    },
    {
      title:  'Ingresos mes',
      value:  formatCurrency(stats.monthRevenue),
      linkTo: '/admin/pedidos',
      accent: false,
    },
  ], [stats])

  return (
    <div className="min-h-screen bg-[#FFF8F5] p-4 md:p-8">
      <ToastContainer />

      {/* Header */}
      <header className="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <p className="text-[10px] font-['DM_Sans'] uppercase tracking-[0.15em] text-[#9A7480] mb-2">
            KB Dresses & More
          </p>
          <h1 className="font-['Cormorant_Garamond'] text-4xl font-light tracking-tight text-[#1A1118]">
            Dashboard
          </h1>
          <p className="text-sm text-[#9A7480] font-['DM_Sans'] mt-1">
            Resumen operativo de tu tienda
          </p>
        </div>

        <div className="flex items-center gap-3">
          <button
            onClick={handleExportCSV}
            className="px-4 py-2 border border-[rgba(212,120,138,0.25)] text-[#9A7480] rounded-sm text-sm font-['DM_Sans'] hover:bg-[#FDF0F3] hover:border-[rgba(212,120,138,0.4)] transition-all"
          >
            Exportar CSV
          </button>
        </div>
      </header>

      {hasError && (
        <ErrorBanner
          message="No se pudieron cargar las estadísticas."
          onRetry={() => { setHasError(false); reloadStats() }}
        />
      )}

      {isLoading ? (
        <DashboardSkeleton />
      ) : (
        <div className="space-y-8">
          {/* Stats grid */}
          <section>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {statCards.map((card) => (
                <StatCard key={card.title} {...card} />
              ))}
            </div>
          </section>

          {/* Ajustes recientes */}
          {recentAdjustments.length > 0 && (
            <section className="bg-white rounded-sm border border-[rgba(212,120,138,0.12)] shadow-[0_1px_4px_rgba(26,17,24,0.03)] p-6">
              <SectionHeader
                title="Descuentos de esta sesión"
                subtitle="Productos ajustados recientemente"
                badge={
                  <span className="text-xs font-medium text-[#B85268] bg-[#D4788A]/10 border border-[#D4788A]/20 px-2.5 py-1 rounded-full font-['DM_Sans']">
                    {recentAdjustments.length} ajuste{recentAdjustments.length !== 1 ? 's' : ''}
                  </span>
                }
              />
              <div className="space-y-3">
                {recentAdjustments.map((product) => (
                  <RecentAdjustmentCard
                    key={product.id}
                    product={product}
                    onReadjust={readjustProduct}
                    onConfirm={confirmAdjustment}
                  />
                ))}
              </div>
            </section>
          )}

          {/* Productos estancados */}
          {filteredStagnantProducts.length > 0 && (
            <section className="bg-white rounded-sm border border-[rgba(212,120,138,0.12)] shadow-[0_1px_4px_rgba(26,17,24,0.03)] p-6">
              <SectionHeader
                title="Baja rotación"
                subtitle={`Sin ventas hace más de ${dayThreshold} días`}
                badge={
                  <div className="flex items-center gap-2">
                    <select
                      value={dayThreshold}
                      onChange={handleDayThresholdChange}
                      className="px-3 py-1.5 border border-[rgba(212,120,138,0.2)] rounded-sm text-xs font-['DM_Sans'] text-[#1A1118] bg-white focus:outline-none focus:ring-1 focus:ring-[#D4788A]"
                    >
                      {DAY_FILTER_OPTIONS.map(({ value, label }) => (
                        <option key={value} value={value}>{label}</option>
                      ))}
                    </select>
                    <input
                      type="search"
                      placeholder="Buscar producto..."
                      value={searchQuery}
                      onChange={(e) => setSearchQuery(e.target.value)}
                      className="px-3 py-1.5 border border-[rgba(212,120,138,0.2)] rounded-sm text-xs font-['DM_Sans'] text-[#1A1118] bg-white placeholder:text-[#9A7480] focus:outline-none focus:ring-1 focus:ring-[#D4788A] w-40"
                    />
                  </div>
                }
              />

              <div className="space-y-4">
                {filteredStagnantProducts.slice(0, 5).map((product) => (
                  <StagnantProductCard
                    key={product.id}
                    product={product}
                    discountValue={discountMap[product.id] ?? 0}
                    onDiscountChange={updateDiscount}
                    onApply={handleApplyDiscount}
                    isApplying={applyingId === product.id}
                  />
                ))}
              </div>

              {filteredStagnantProducts.length > 5 && (
                <p className="text-xs text-[#9A7480] font-['DM_Sans'] text-center mt-5 pt-5 border-t border-[rgba(212,120,138,0.1)]">
                  Mostrando 5 de {filteredStagnantProducts.length} productos. Ajusta los filtros para ver más.
                </p>
              )}
            </section>
          )}

          {/* Acciones rápidas */}
          <section className="bg-white rounded-sm border border-[rgba(212,120,138,0.12)] shadow-[0_1px_4px_rgba(26,17,24,0.03)] p-6">
            <SectionHeader title="Acciones rápidas" />
            <div className="flex flex-wrap gap-3">
              <Link
                to="/admin/productos"
                className="px-4 py-2 bg-[#1A1118] text-[#FFF8F5] rounded-sm text-sm font-['DM_Sans'] font-medium hover:bg-[#2D2030] transition-colors"
              >
                Nuevo producto
              </Link>
              <Link
                to="/admin/pedidos"
                className="px-4 py-2 border border-[rgba(212,120,138,0.25)] text-[#9A7480] rounded-sm text-sm font-['DM_Sans'] font-medium hover:bg-[#FDF0F3] transition-colors"
              >
                Ver pedidos
              </Link>
              <Link
                to="/"
                target="_blank"
                rel="noopener noreferrer"
                className="px-4 py-2 border border-[rgba(212,120,138,0.25)] text-[#9A7480] rounded-sm text-sm font-['DM_Sans'] font-medium hover:bg-[#FDF0F3] transition-colors"
              >
                Ver tienda
              </Link>
            </div>
          </section>
        </div>
      )}
    </div>
  )
}

export default DashboardPage
</file>

<file path="src/index.css">
/* ============================================
   IMPORTACIÓN DE FUENTES
   ============================================ */
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,200;0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap');

/* ============================================
   TAILWIND CSS V4
   ============================================ */
@import "tailwindcss";

/* ============================================
   PALETA KB DRESSES — FEMME LUXE EDITORIAL
   ============================================ */
@theme {
  /* Core rose palette — rico y profundo */
  --color-kb-rose:      #D4788A;
  --color-kb-rose-deep: #B85268;
  --color-kb-rose-mist: #F2C4CE;
  --color-kb-blush:     #FDF0F3;
  --color-kb-soft-pink: #EAA8B5;
  --color-kb-mauve:     #9A7480;
  --color-kb-petal:     #F8D7DE;

  /* Neutrals dramáticos */
  --color-kb-obsidian:  #1A1118;
  --color-kb-charcoal:  #2D2030;
  --color-kb-warm-gray: #7A6B72;
  --color-kb-cream:     #FDFAF9;
  --color-kb-ivory:     #FFF8F5;

  /* Accent */
  --color-kb-gold:      #C9A84C;
  --color-kb-gold-light:#E8D08A;

  /* Semánticos */
  --color-background:        #FDFAF9;
  --color-foreground:        #1A1118;
  --color-muted:             #FDF0F3;
  --color-muted-foreground:  #9A7480;
  --color-border:            rgba(212, 120, 138, 0.15);

  /* Tipografía */
  --font-display: 'Cormorant Garamond', Georgia, serif;
  --font-sans:    'DM Sans', system-ui, sans-serif;
  --font-serif:   'Cormorant Garamond', Georgia, serif;
}

/* ============================================
   RESET & BASE
   ============================================ */
*, *::before, *::after {
  border-color: var(--color-border);
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--color-background);
  color: var(--color-foreground);
  font-family: var(--font-sans);
  font-weight: 300;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: 0.01em;
}

h1, h2, h3, h4, h5, .font-heading, .font-display {
  font-family: var(--font-display);
  letter-spacing: -0.01em;
  font-weight: 400;
}

/* ============================================
   SCROLLBAR EDITORIAL
   ============================================ */
::-webkit-scrollbar { width: 3px; height: 3px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--color-kb-rose-mist); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: var(--color-kb-rose); }

/* ============================================
   KEYFRAMES
   ============================================ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(32px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes scaleReveal {
  from { opacity: 0; transform: scale(0.96) translateY(16px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes shimmer {
  0%   { background-position: -200% center; }
  100% { background-position:  200% center; }
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  33%       { transform: translateY(-6px) rotate(0.5deg); }
  66%       { transform: translateY(-3px) rotate(-0.5deg); }
}

@keyframes slideInRight {
  from { transform: translateX(100%); opacity: 0; }
  to   { transform: translateX(0);    opacity: 1; }
}

@keyframes slideInDown {
  from { transform: translateY(-12px); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}

@keyframes pulse-soft {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.6; }
}

@keyframes marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Utility classes */
.animate-fade-up       { animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.animate-fade-in       { animation: fadeIn 0.5s ease-out forwards; }
.animate-scale-reveal  { animation: scaleReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.animate-slide-in      { animation: slideInRight 0.45s cubic-bezier(0.16, 1, 0.3, 1); }
.animate-slide-down    { animation: slideInDown 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
.animate-float         { animation: float 7s ease-in-out infinite; }
.animate-pulse-soft    { animation: pulse-soft 2.5s ease-in-out infinite; }

/* ============================================
   HEADER SYSTEM — GLASSMORPHISM PROFUNDO
   ============================================ */

/* Topbar de anuncios — gradiente animado */
.kb-topbar {
  background: linear-gradient(
    90deg,
    var(--color-kb-obsidian) 0%,
    var(--color-kb-charcoal) 40%,
    #3D1F2D 70%,
    var(--color-kb-obsidian) 100%
  );
  color: var(--color-kb-rose-mist);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 0.55rem 0;
  position: relative;
  overflow: hidden;
}

.kb-topbar::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 20%, rgba(212,120,138,0.06) 50%, transparent 80%);
  animation: shimmer 4s linear infinite;
  background-size: 200% auto;
}

/* Navbar glass */
.kb-navbar {
  background: rgba(253, 250, 249, 0.82);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border-bottom: 1px solid rgba(212, 120, 138, 0.1);
  transition: background 0.4s ease, box-shadow 0.4s ease, padding 0.4s ease;
}

.kb-navbar.scrolled {
  background: rgba(253, 250, 249, 0.96);
  box-shadow: 0 1px 0 rgba(212,120,138,0.12), 0 8px 32px rgba(26,17,24,0.06);
  padding-top: 0.6rem !important;
  padding-bottom: 0.6rem !important;
}

/* Logo transición al hacer scroll */
.kb-logo {
  transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  filter: drop-shadow(0 2px 8px rgba(212,120,138,0.12));
}

.kb-logo:hover {
  filter: drop-shadow(0 4px 16px rgba(212,120,138,0.28));
}

/* Nav links editorial */
.kb-nav-link {
  font-family: var(--font-sans);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-kb-charcoal);
  position: relative;
  padding-bottom: 2px;
  transition: color 0.3s ease;
}

.kb-nav-link::before {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 1px;
  background: linear-gradient(90deg, var(--color-kb-rose), var(--color-kb-soft-pink));
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.kb-nav-link:hover {
  color: var(--color-kb-rose);
}

.kb-nav-link:hover::before {
  width: 100%;
}

/* Separador decorativo nav */
.kb-nav-dot {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--color-kb-rose-mist);
  flex-shrink: 0;
}

/* Botón carrito premium */
.kb-cart-btn {
  position: relative;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(212,120,138,0.2);
  background: rgba(242,196,206,0.08);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.kb-cart-btn:hover {
  background: rgba(212,120,138,0.12);
  border-color: var(--color-kb-rose);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(212,120,138,0.2);
}

.kb-cart-badge {
  position: absolute;
  top: -3px;
  right: -3px;
  background: linear-gradient(135deg, var(--color-kb-rose), var(--color-kb-rose-deep));
  color: white;
  font-size: 0.6rem;
  font-weight: 600;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5px solid var(--color-kb-ivory);
  animation: scaleReveal 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ============================================
   MARQUEE — barra de texto deslizante
   ============================================ */
.kb-marquee-track {
  display: flex;
  width: max-content;
  animation: marquee 22s linear infinite;
}

.kb-marquee-track:hover {
  animation-play-state: paused;
}

/* ============================================
   FOOTER — OBSIDIAN LUXURY
   ============================================ */
.kb-footer {
  background: var(--color-kb-obsidian);
  color: rgba(253,240,243,0.7);
  position: relative;
  overflow: hidden;
}

/* Textura sutil en el footer */
.kb-footer::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 20% 80%, rgba(212,120,138,0.06) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(184,82,104,0.04) 0%, transparent 50%);
  pointer-events: none;
}

/* Línea decorativa footer */
.kb-footer-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(212,120,138,0.4), rgba(212,120,138,0.15), transparent);
}

/* Links footer */
.kb-footer-link {
  color: rgba(154,116,128,0.8);
  font-size: 0.82rem;
  font-weight: 300;
  letter-spacing: 0.03em;
  transition: color 0.3s ease, letter-spacing 0.3s ease;
  display: inline-block;
}

.kb-footer-link:hover {
  color: var(--color-kb-rose-mist);
  letter-spacing: 0.06em;
}

/* Heading footer */
.kb-footer-heading {
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-kb-rose-mist);
  margin-bottom: 1.4rem;
}

/* Social icons footer */
.kb-social-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(212,120,138,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(212,120,138,0.6);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.kb-social-btn:hover {
  border-color: var(--color-kb-rose);
  color: var(--color-kb-rose);
  background: rgba(212,120,138,0.08);
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 8px 24px rgba(212,120,138,0.15);
}

/* ============================================
   BOTONES KB
   ============================================ */
.btn-kb-primary {
  @apply font-sans font-medium tracking-widest uppercase text-xs;
  background: var(--color-kb-obsidian);
  color: var(--color-kb-ivory);
  padding: 0.9rem 2.5rem;
  border-radius: 2px;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
  letter-spacing: 0.15em;
}

.btn-kb-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--color-kb-rose), var(--color-kb-rose-deep));
  opacity: 0;
  transition: opacity 0.35s ease;
}

.btn-kb-primary:hover::before { opacity: 1; }
.btn-kb-primary span { position: relative; z-index: 1; }

.btn-kb-secondary {
  @apply font-sans font-medium tracking-widest uppercase text-xs;
  border: 1px solid var(--color-kb-obsidian);
  color: var(--color-kb-obsidian);
  padding: 0.9rem 2.5rem;
  border-radius: 2px;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  letter-spacing: 0.15em;
}

.btn-kb-secondary:hover {
  background: var(--color-kb-obsidian);
  color: var(--color-kb-ivory);
}

.btn-kb-accent {
  @apply font-sans font-medium tracking-widest uppercase text-xs;
  background: linear-gradient(135deg, var(--color-kb-rose), var(--color-kb-rose-deep));
  color: white;
  padding: 0.75rem 1.75rem;
  border-radius: 2px;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  letter-spacing: 0.12em;
  box-shadow: 0 4px 16px rgba(212,120,138,0.3);
}

.btn-kb-accent:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(212,120,138,0.4);
}

.btn-kb-ghost {
  @apply font-sans font-light tracking-widest uppercase text-xs;
  border-bottom: 1px solid currentColor;
  color: var(--color-kb-rose-deep);
  padding: 0.15rem 0;
  transition: all 0.3s ease;
  letter-spacing: 0.15em;
}

.btn-kb-ghost:hover {
  letter-spacing: 0.22em;
  color: var(--color-kb-rose);
}

/* ============================================
   BADGES
   ============================================ */
.badge-new {
  @apply font-sans font-medium text-white uppercase;
  background: var(--color-kb-obsidian);
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  padding: 0.25rem 0.65rem;
  border-radius: 1px;
}

.badge-sale {
  @apply font-sans font-medium text-white uppercase;
  background: linear-gradient(135deg, #C0392B, #E74C3C);
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  padding: 0.25rem 0.65rem;
  border-radius: 1px;
}

.badge-premium {
  @apply font-sans font-medium text-white uppercase;
  background: linear-gradient(135deg, var(--color-kb-gold), var(--color-kb-gold-light));
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  padding: 0.25rem 0.65rem;
  border-radius: 1px;
}

/* ============================================
   UTILIDADES TIPOGRÁFICAS
   ============================================ */
.text-gradient-rose {
  background: linear-gradient(135deg, var(--color-kb-rose-deep) 0%, var(--color-kb-rose) 50%, var(--color-kb-soft-pink) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.text-elegant {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 300;
  letter-spacing: -0.02em;
}

.text-editorial {
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

/* ============================================
   TARJETAS DE PRODUCTO
   ============================================ */
.product-card {
  position: relative;
  overflow: hidden;
  background: white;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 60px rgba(26,17,24,0.1), 0 6px 20px rgba(212,120,138,0.08);
}

.product-card-img {
  overflow: hidden;
}

.product-card-img img {
  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-card:hover .product-card-img img {
  transform: scale(1.06);
}

.product-grid {
  @apply grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-10;
}

/* ============================================
   INPUTS
   ============================================ */
.input-kb {
  @apply w-full px-4 py-3 text-sm font-light;
  border: 1px solid rgba(212,120,138,0.25);
  border-radius: 2px;
  background: white;
  color: var(--color-kb-charcoal);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
  outline: none;
  letter-spacing: 0.02em;
}

.input-kb::placeholder {
  color: var(--color-kb-mauve);
  font-weight: 300;
}

.input-kb:focus {
  border-color: var(--color-kb-rose);
  box-shadow: 0 0 0 3px rgba(212,120,138,0.08), 0 2px 8px rgba(212,120,138,0.1);
}

.select-kb {
  @apply w-full px-4 py-3 text-sm font-light appearance-none;
  border: 1px solid rgba(212,120,138,0.25);
  border-radius: 2px;
  background: white;
  color: var(--color-kb-charcoal);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
  outline: none;
  cursor: pointer;
}

.select-kb:focus {
  border-color: var(--color-kb-rose);
  box-shadow: 0 0 0 3px rgba(212,120,138,0.08);
}

/* ============================================
   SOMBRAS ELEGANTES
   ============================================ */
.shadow-elegant {
  box-shadow: 0 2px 16px -4px rgba(26,17,24,0.07), 0 1px 4px rgba(26,17,24,0.04);
}

.shadow-rose {
  box-shadow: 0 8px 32px rgba(212,120,138,0.2);
}

.shadow-deep {
  box-shadow: 0 16px 64px rgba(26,17,24,0.12), 0 4px 16px rgba(26,17,24,0.06);
}

/* ============================================
   OVERLAYS
   ============================================ */
.overlay-rose {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(26,17,24,0.5) 100%);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.group:hover .overlay-rose { opacity: 1; }

/* ============================================
   TOAST
   ============================================ */
   @keyframes slide-in {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.animate-slide-in {
  animation: slide-in 0.3s ease-out;
}
.toast-container {
  @apply fixed top-5 right-5 z-50 flex flex-col gap-2;
}

.toast {
  background: var(--color-kb-obsidian);
  color: var(--color-kb-ivory);
  padding: 0.85rem 1.25rem;
  border-radius: 3px;
  border-left: 3px solid var(--color-kb-rose);
  box-shadow: 0 8px 32px rgba(26,17,24,0.2);
  font-size: 0.82rem;
  font-weight: 300;
  letter-spacing: 0.02em;
  animation: slideInRight 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  max-width: 320px;
}

.toast-success { border-left-color: #4CAF50; }
.toast-error   { border-left-color: #E53935; }

/* ============================================
   RESPONSIVE HELPERS
   ============================================ */
@media (max-width: 768px) {
  .hide-mobile  { display: none !important; }
}

@media (min-width: 769px) {
  .hide-desktop { display: none !important; }
}
