              radial-gradient(ellipse 50% 50% at 50% 50%, rgba(242,196,206,0.05) 0%, transparent 60%)
            `,
          }}
        />

        {/* Partículas brillantes animadas */}
        {[...Array(6)].map((_, i) => (
          <div
            key={i}
